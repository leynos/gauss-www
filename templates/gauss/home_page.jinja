{% extends "_layout.jinja" %}

{% block title %}Gauss — the document is the interface{% endblock %}
{% block description %}Gauss is an open-source SVG editor designed so drawing, accessibility, and automation meet the same document model.{% endblock %}

{% block content %}
  <section class="gauss-hero" id="why" aria-labelledby="hero-title">
    <div class="gauss-hero__copy">
      <nav class="tabs tabs-border gauss-representations" aria-label="Specimen representations">
        <a class="tab tab-active" href="#specimen-artwork" aria-current="page">Artwork</a>
        <a class="tab" href="#specimen-paths">Paths</a>
        <a class="tab" href="#specimen-svg">SVG</a>
      </nav>

      <h1 id="hero-title">The document is the interface.</h1>
      <p class="gauss-hero__lede">
        Gauss treats the vector document as the shared centre of drawing,
        accessibility, and automation. Open-source SVG illustration with a
        command model designed for scriptable precision.
      </p>
      <div class="gauss-hero__actions">
        <a class="btn btn-primary gauss-action" href="#drawing">Explore Gauss</a>
        <a class="btn btn-outline gauss-action" href="{{ repository_url }}#building">Build from source</a>
      </div>
      <p><a class="link link-primary" href="{{ repository_url }}">View Gauss source on GitHub</a></p>

      <ul class="gauss-status-rail" aria-label="Project status">
        <li>Phase 0 proof of concept</li>
        <li>Rust + GPUI</li>
        <li>SVG import/export</li>
        <li>Designed for accessibility</li>
      </ul>
    </div>

    <figure class="gauss-specimen" id="specimen-artwork">
      <svg class="gauss-specimen__art" viewBox="0 0 620 520" role="img" aria-labelledby="specimen-title specimen-description">
        <title id="specimen-title">A botanical letter G with editable vector paths</title>
        <desc id="specimen-description">Cobalt curves form a large letter G among pale leaves. Vermilion handles and square anchor points expose the artwork's Bézier construction.</desc>
        <g class="gauss-specimen__guides" aria-hidden="true">
          <path d="M100 100 L500 420" />
          <path d="M120 430 L500 80" />
          <circle cx="300" cy="260" r="178" />
        </g>
        <g class="gauss-specimen__leaves" aria-hidden="true">
          <path d="M364 120 C430 64 508 62 546 38 C525 118 458 159 374 153 Z" />
          <path d="M388 184 C466 143 540 162 568 200 C486 227 430 222 380 207 Z" />
          <path d="M392 334 C474 294 548 320 575 362 C501 382 442 376 380 352 Z" />
          <path d="M217 128 C166 85 119 89 82 114 C121 160 169 171 224 153 Z" />
        </g>
        <g class="gauss-specimen__letter" aria-hidden="true">
          <path d="M372 178 C340 105 205 92 157 193 C108 297 166 423 291 425 C357 426 401 401 424 366 L424 292 L310 292" />
          <path d="M422 293 C457 273 485 240 490 195 C495 151 466 128 438 151 C418 168 426 202 453 206" />
          <path d="M290 425 C377 405 442 353 492 278" />
        </g>
        <g class="gauss-specimen__handles" aria-hidden="true">
          <path d="M157 193 L102 147 M157 193 L129 276" />
          <path d="M291 425 L226 450 M291 425 L355 398" />
          <path d="M490 195 L526 156 M490 195 L515 235" />
          <circle cx="102" cy="147" r="5" />
          <circle cx="129" cy="276" r="5" />
          <circle cx="226" cy="450" r="5" />
          <circle cx="355" cy="398" r="5" />
          <circle cx="526" cy="156" r="5" />
          <circle cx="515" cy="235" r="5" />
        </g>
        <g class="gauss-specimen__nodes" aria-hidden="true">
          <rect x="152" y="188" width="10" height="10" />
          <rect x="286" y="420" width="10" height="10" />
          <rect x="419" y="287" width="10" height="10" />
          <rect x="485" y="190" width="10" height="10" />
        </g>
      </svg>
      <figcaption>This drawing grows with Gauss.</figcaption>
    </figure>
  </section>

  <section class="gauss-section gauss-drawing" id="drawing" aria-labelledby="drawing-title">
    <div class="gauss-section__copy">
      <h2 id="drawing-title">Drawing should still feel like drawing.</h2>
      <p>
        Place points. Shape Bézier curves with handles that behave. Edit fill
        and stroke with clarity. Undo with confidence.
      </p>
    </div>
    <figure class="mockup-window gauss-editor-proof">
      <div class="gauss-editor-proof__canvas">
        <svg viewBox="0 0 720 300" role="img" aria-label="Illustrative Gauss editor composition showing a selected leaf path and its Bézier handles">
          <path class="gauss-editor-proof__stem" d="M110 270 C180 205 248 126 344 50" />
          <path class="gauss-editor-proof__leaf" d="M184 202 C265 118 380 104 470 124 C390 214 292 242 184 202 Z" />
          <path class="gauss-editor-proof__handle" d="M184 202 L250 126 M470 124 L530 162" />
          <circle class="gauss-editor-proof__point" cx="250" cy="126" r="5" />
          <circle class="gauss-editor-proof__point" cx="530" cy="162" r="5" />
        </svg>
      </div>
      <figcaption class="gauss-editor-proof__caption">
        Framework illustration. Replace with a current Gauss application capture before publication.
      </figcaption>
    </figure>
  </section>

  <section class="gauss-section gauss-architecture" id="architecture" aria-labelledby="architecture-title">
    <div class="gauss-section__copy">
      <h2 id="architecture-title">One document. Every way in.</h2>
      <p>
        Every interface meets the same document model. Status belongs in the
        diagram, so planned work reads as engineering state rather than fine
        print.
      </p>
    </div>
    <div class="gauss-port-map">
      <article class="card card-border gauss-port" data-status="shipped">
        <div class="card-body">
          <span class="badge badge-success badge-soft">Shipped</span>
          <h3 class="card-title">Direct manipulation</h3>
          <p>Pointer and touch editing.</p>
        </div>
      </article>
      <article class="card card-border gauss-port" data-status="partial">
        <div class="card-body">
          <span class="badge badge-warning badge-soft">Partial</span>
          <h3 class="card-title">Keyboard and accessibility</h3>
          <p>Focus, navigation, and semantic actions.</p>
        </div>
      </article>
      <article class="card card-border gauss-port gauss-port--model">
        <div class="card-body">
          <h3 class="card-title">Document model</h3>
          <p>Paths · styles · metadata · history</p>
        </div>
      </article>
      <article class="card card-border gauss-port" data-status="planned">
        <div class="card-body">
          <span class="badge badge-ghost">Planned</span>
          <h3 class="card-title">Scripting API</h3>
          <p>Query, mutate, and automate.</p>
        </div>
      </article>
      <article class="card card-border gauss-port" data-status="shipped">
        <div class="card-body">
          <span class="badge badge-success badge-soft">Shipped</span>
          <h3 class="card-title">SVG I/O</h3>
          <p>Import and export.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="gauss-section gauss-file" id="specimen-svg" aria-labelledby="file-title">
    <div class="gauss-section__copy">
      <p class="gauss-kicker">Vector illustration, open all the way down</p>
      <h2 id="file-title">The file is already yours.</h2>
      <p>Gauss speaks SVG. Edit visually. Inspect the code. Share without friction.</p>
    </div>
    <div class="gauss-file__comparison">
      <div id="specimen-paths" class="gauss-file__art">
        <svg viewBox="0 0 360 220" role="img" aria-label="A selected leaf drawn as a cobalt Bézier path">
          <path d="M40 190 C102 70 220 28 326 48 C238 158 142 206 40 190 Z" />
          <circle cx="40" cy="190" r="5" />
          <circle cx="326" cy="48" r="5" />
        </svg>
      </div>
      <pre class="mockup-code gauss-file__code"><code>&lt;path
  id="leaf-7"
  d="M40 190 C102 70 220 28 326 48 ..."
  fill="#eef2ff"
  stroke="#2457c5" /&gt;</code></pre>
    </div>
  </section>

  <section class="gauss-automation" aria-labelledby="automation-title">
    <div class="gauss-automation__inner">
      <div>
        <h2 id="automation-title">If it can be clicked, it should be callable.</h2>
        <p>Scriptability should emerge from the command architecture itself.</p>
      </div>
      <div class="gauss-command-map">
        <code>select --id leaf-7</code>
        <span aria-hidden="true">→</span>
        <code>document.select(id)</code>
        <span aria-hidden="true">→</span>
        <span>Focus set</span>
      </div>
      <p class="gauss-automation__notice">Illustrative · scripting remains planned</p>
    </div>
  </section>

  <section class="gauss-closing" aria-label="Next steps">
    <article>
      <h2>Build Gauss</h2>
      <p>Clone the repository and run the current proof of concept.</p>
      <a href="{{ repository_url }}#building">Build Gauss from source</a>
    </article>
    <article>
      <h2>Read the roadmap</h2>
      <p>See what is shipped, partial, and planned.</p>
      <a href="/gauss/roadmap/">Read the Gauss roadmap</a>
    </article>
    <article>
      <h2>Browse the source</h2>
      <p>Inspect the open-source implementation on GitHub.</p>
      <a href="{{ repository_url }}">Browse Gauss on GitHub</a>
    </article>
  </section>
{% endblock %}
